### 2. Context7 Response Validation
```python
import ast
import sys

def validate_context7_code(code_string: str) -> dict:
    """
    Validate Context7 generated Python code
    """
    try:
        # Parse the code
        tree = ast.parse(code_string)
        
        # Basic validation checks
        checks = {
            'syntax_valid': True,
            'has_imports': any(isinstance(node, ast.Import) for node in ast.walk(tree)),
            'has_functions': any(isinstance(node, ast.FunctionDef) for node in ast.walk(tree)),
            'has_docstrings': False,
            'python_version_compatible': sys.version_info >= (3, 8)
        }
        
        # Check for docstrings
        for node in ast.walk(tree):
            if isinstance(node, ast.FunctionDef):
                if (node.body and isinstance(node.body[0], ast.Expr) and 
                    isinstance(node.body[0].value, ast.Str)):
                    checks['has_docstrings'] = True
                    break
        
        return checks
        
    except SyntaxError as e:
        return {'syntax_valid': False, 'error': str(e)}
```

