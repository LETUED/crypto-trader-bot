class PrivacyFirstMemoryManager:
    """Memory manager with privacy protection"""
    
    def __init__(self, user_id: str):
        self.user_id = self.hash_user_id(user_id)
        self.sensitive_patterns = [
            r'\b\d{3}-\d{2}-\d{4}\b',  # SSN pattern
            r'\b\d{4}-\d{4}-\d{4}-\d{4}\b',  # Credit card pattern
            r'\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Z|a-z]{2,}\b'  # Email
        ]
        
    def sanitize_before_storage(self, content: str) -> str:
        """Remove sensitive information before storing"""
        sanitized = content
        for pattern in self.sensitive_patterns:
            sanitized = re.sub(pattern, '[REDACTED]', sanitized)
        return sanitized
        
    def add_privacy_metadata(self, content: str) -> str:
        """Add privacy classification to memory"""
        privacy_level = self.classify_privacy_level(content)
        return f"[PRIVACY:{privacy_level}] {content}"
```

