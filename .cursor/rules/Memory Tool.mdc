class MemorySearchOptimizer:
    """Optimize memory search queries for better relevance"""
    
    def __init__(self):
        self.search_history: Dict[str, List[str]] = {}
        
    def optimize_search_query(self, user_id: str, query: str) -> str:
        """Enhance search query based on user patterns"""
        # Add user context
        enhanced_query = f"User {user_id}: {query}"
        
        # Add temporal context
        enhanced_query += f" | Recent context from last 24 hours"
        
        # Add categorical context based on query type
        if any(word in query.lower() for word in ["preference", "like", "dislike"]):
            enhanced_query += " | User preferences and settings"
        elif any(word in query.lower() for word in ["problem", "issue", "error"]):
            enhanced_query += " | Problem-solving and troubleshooting"
        elif any(word in query.lower() for word in ["learn", "tutorial", "how"]):
            enhanced_query += " | Learning and educational content"
            
        return enhanced_query
        
    def process_search_results(self, results: List[Dict], query: str) -> List[Dict]:
        """Post-process search results for better relevance"""
        # Sort by relevance score
        sorted_results = sorted(results, key=lambda x: x.get('relevance', 0), reverse=True)
        
        # Filter out low-relevance results
        filtered_results = [r for r in sorted_results if r.get('relevance', 0) > 0.3]
        
        return filtered_results[:5]  # Return top 5 most relevant
